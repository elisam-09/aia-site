# ─── Contenu (back-office Sanity) ───────────────────────────────
# Laisse ces variables VIDES pour utiliser le contenu de démonstration local.
# Renseigne-les une fois ton projet Sanity créé (voir DEPLOIEMENT.md) : le site
# basculera automatiquement sur le contenu saisi par le bureau, sans changer de code.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# ─── Formulaires (Rejoindre / Contact) ──────────────────────────
# Endpoint d'envoi de formulaire (Web3Forms, Formspree, Getform…).
# Si vide, les formulaires ouvrent l'application e-mail avec un message pré-rempli.
PUBLIC_FORM_ENDPOINT=
# Adresse affichée et utilisée en repli e-mail.
PUBLIC_CONTACT_EMAIL=contact@aia-ci.org
