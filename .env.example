# ─── Base de données & fichiers (optionnel) ─────────────────────
# Emplacements par défaut : data/aia.db et uploads/ à la racine du projet.
# À personnaliser surtout en production (ex. un disque persistant monté).
# DATABASE_PATH=data/aia.db
# UPLOADS_PATH=uploads

# ─── Formulaires publics Rejoindre / Contact ────────────────────
# Ces formulaires du SITE VITRINE (pas l'admin) envoient par un service tiers.
# Endpoint d'envoi (Web3Forms, Formspree…). Si vide → ouverture de l'app e-mail.
PUBLIC_FORM_ENDPOINT=
# Adresse affichée et utilisée en repli e-mail.
PUBLIC_CONTACT_EMAIL=contact@aia-ci.org

# ─── Rappel ─────────────────────────────────────────────────────
# Le portail d'administration (/admin) ne nécessite AUCUNE variable :
# il fonctionne avec la base SQLite locale. Crée le premier compte avec :
#   npm run admin:creer
