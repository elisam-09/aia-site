# Reverse-proxy Caddy — HTTPS automatique (Let's Encrypt) + envoi vers le serveur Node local.
# À copier dans /etc/caddy/Caddyfile (voir DEPLOIEMENT-HOSTINGER.md), puis `sudo systemctl reload caddy`.

# --- Une fois le domaine réservé et pointé sur l'IP du VPS : remplace par ton domaine ---
aia-ci.org, www.aia-ci.org {
	encode gzip zstd
	reverse_proxy 127.0.0.1:4321
}

# --- En attendant le domaine, pour tester via l'adresse IP en HTTP :
# (décommente ce bloc et commente celui du dessus)
# :80 {
# 	encode gzip zstd
# 	reverse_proxy 127.0.0.1:4321
# }
