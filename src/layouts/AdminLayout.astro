---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '../styles/admin.css';
import CielAdmin from '../components/admin/CielAdmin.astro';
import { countAdhesionsParStatut } from '../server/db/repo';

interface Props {
  title: string;
  /** Phrase d'explication sous le titre */
  description?: string;
}
const { title, description } = Astro.props;
const admin = Astro.locals.admin!; // le middleware garantit sa présence sur /admin
const path = Astro.url.pathname;
const nouvelles = countAdhesionsParStatut().nouvelle;

/** Icônes au trait (24×24), pas d'émoticônes. */
const I = {
  bord: '<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>',
  paiements: '<rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 9v.01M18 15v.01"/>',
  audience: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  adhesions: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.6-3.6 3.2-5.5 6.5-5.5s5.9 1.9 6.5 5.5"/><path d="M19 8v6M16 11h6"/>',
  evenements: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  actualites: '<path d="M5 4h11a2 2 0 0 1 2 2v14H6a2 2 0 0 1-2-2V5a1 1 0 0 1 1-1z"/><path d="M18 8h2v10a2 2 0 0 1-2 2M8 8h6M8 12h6M8 16h4"/>',
  galerie: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-8 9"/>',
  partenaires: '<circle cx="8" cy="12" r="4.5"/><circle cx="16" cy="12" r="4.5"/>',
  membres: '<circle cx="12" cy="8" r="4"/><path d="M4 21c.8-4.2 4-6.5 8-6.5s7.2 2.3 8 6.5"/>',
  reglages: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1L7 17M17 7l2.1-2.1"/>',
  comptes: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
};

const groupes: { titre?: string; liens: { href: string; label: string; ic: string; n?: number }[] }[] = [
  {
    liens: [
      { href: '/admin', label: 'Tableau de bord', ic: I.bord },
      { href: '/admin/adhesions', label: 'Adhésions', ic: I.adhesions, n: nouvelles },
      { href: '/admin/paiements', label: 'Paiements', ic: I.paiements },
      { href: '/admin/audience', label: 'Audience', ic: I.audience },
    ],
  },
  {
    titre: 'Contenu',
    liens: [
      { href: '/admin/evenements', label: 'Événements', ic: I.evenements },
      { href: '/admin/actualites', label: 'Articles', ic: I.actualites },
      { href: '/admin/galerie', label: 'Galerie', ic: I.galerie },
      { href: '/admin/membres', label: 'Équipe', ic: I.membres },
      { href: '/admin/partenaires', label: 'Partenaires', ic: I.partenaires },
    ],
  },
  {
    titre: 'Site',
    liens: [
      { href: '/admin/reglages', label: 'Réglages', ic: I.reglages },
      ...(admin.role === 'admin' ? [{ href: '/admin/comptes', label: 'Comptes', ic: I.comptes }] : []),
    ],
  },
];

const actif = (href: string) =>
  href === '/admin' ? path === '/admin' || path === '/admin/' : path.startsWith(href);

// Notification après une action (?ok=enregistre | supprime | duplique)
const MESSAGES: Record<string, string> = {
  enregistre: 'Modifications enregistrées.',
  cree: 'Élément créé.',
  supprime: 'Élément supprimé.',
  duplique: 'Copie créée (masquée) : modifie-la puis publie-la.',
};
const toast = MESSAGES[Astro.url.searchParams.get('ok') ?? ''];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#120A12" />
    <title>{title} · Administration AIA</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
  </head>
  <body>
    <CielAdmin />

    <div class="adm">
      <aside class="adm__aside">
        <a class="adm__marque" href="/admin">
          <img src="/favicon.png" alt="" />
          <span>
            <strong>AIA</strong>
            <small>Espace bureau</small>
          </span>
        </a>

        <nav class="adm__nav" aria-label="Administration">
          {
            groupes.map((g) => (
              <>
                {g.titre && <p class="adm__sep">{g.titre}</p>}
                {g.liens.map((l) => (
                  <a
                    href={l.href}
                    class:list={['adm__lien', { actif: actif(l.href) }]}
                    aria-current={actif(l.href) ? 'page' : undefined}
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={l.ic} />
                    {l.label}
                    {l.n ? <span class="adm__compteur" title={`${l.n} nouvelle(s)`}>{l.n}</span> : null}
                  </a>
                ))}
              </>
            ))
          }
        </nav>

        <div class="adm__qui">
          <div>
            <strong>{admin.nom}</strong>
            <span class:list={['adm__badge', { admin: admin.role === 'admin' }]}>
              {admin.role === 'admin' ? 'Administrateur' : 'Éditeur'}
            </span>
          </div>
          <div class="rangee">
            <a class="bouton bouton--contour bouton--sm" href="/" target="_blank" rel="noopener">Voir le site ↗</a>
            <form method="POST" action="/admin/logout">
              <button class="bouton bouton--contour bouton--sm" type="submit">Déconnexion</button>
            </form>
          </div>
        </div>
      </aside>

      <main class="adm__main">
        <header class="adm__haut">
          <div>
            <h1>{title}</h1>
            {description && <p>{description}</p>}
          </div>
          <div class="adm__haut-actions"><slot name="actions" /></div>
        </header>

        <slot />
      </main>
    </div>

    {toast && <div class="toast ok" role="status">{toast}</div>}
    {
      toast && (
        <script is:inline>
          // retire ?ok=… de l'adresse pour qu'un rechargement ne réaffiche pas le message
          history.replaceState(null, '', location.pathname + location.hash);
        </script>
      )
    }
  </body>
</html>
