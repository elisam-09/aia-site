---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Starfield from '../components/Starfield.astro';
import Curseur from '../components/Curseur.astro';
import Annonce from '../components/Annonce.astro';
import { useT, altLangUrl, routes, type Lang, type PageId } from '../i18n/ui';

interface Props {
  lang: Lang;
  pageId: PageId;
  title: string;
  description?: string;
  /** Cache le footer standard (l'accueil intègre le sien dans la dernière couche) */
  bareFooter?: boolean;
  /** Page privée ou technique : demande aux moteurs de recherche de ne pas l'indexer */
  noindex?: boolean;
}

const { lang, pageId, title, description, bareFooter = false, noindex = false } = Astro.props;
const t = useT(lang);
const desc = description ?? t('site.description');
const site = Astro.site ?? new URL('https://aia-astronomie.vercel.app');
const canonical = new URL(Astro.url.pathname, site);
const frUrl = new URL(routes[pageId].fr, site);
const enUrl = new URL(routes[pageId].en, site);
const altUrl = altLangUrl(Astro.url.pathname, lang === 'fr' ? 'en' : 'fr');
const ogImage = new URL('/logo-aia-blanc.png', site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {t('site.sigle')}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#120A12" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={frUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.nom')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenu">{lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
    <Starfield />
    <Annonce lang={lang} />
    <Header lang={lang} pageId={pageId} altUrl={altUrl} />
    <main id="contenu">
      <slot />
    </main>
    {!bareFooter && <Footer lang={lang} />}
    <Curseur />
    <script>import '../scripts/mesure.ts';</script>
  </body>
</html>
