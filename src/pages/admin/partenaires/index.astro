---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import * as repo from '../../../server/db/repo';

const partenaires = repo.listPartenaires();
---

<AdminLayout title="Partenaires" description="Les institutions affichées sur la page Partenaires et en bas de l’accueil.">
  <Fragment slot="actions">
    <a class="bouton bouton--primaire" href="/admin/partenaires/nouveau">+ Nouveau partenaire</a>
  </Fragment>

  {
    partenaires.length === 0 ? (
      <div class="lignes"><p class="vide"><b>Aucun partenaire</b>Ajoute les institutions qui soutiennent l’AIA.</p></div>
    ) : (
      <div class="lignes">
        {partenaires.map((p) => (
          <div class="ligne">
            {p.logo ? (
              <img class="vignette" style="background:var(--creme);object-fit:contain;padding:4px" src={p.logo} alt="" />
            ) : (
              <span class="vignette">{(p.sigle ?? p.nom).slice(0, 4)}</span>
            )}
            <div>
              <h3><a href={`/admin/partenaires/${p.id}`}>{p.nom}</a></h3>
              <div class="meta">
                {p.sigle && <span class="pastille">{p.sigle}</span>}
                {p.site && <a href={p.site} target="_blank" rel="noopener">{p.site.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a>}
              </div>
            </div>
            <div class="ac">
              <a class="bouton bouton--contour bouton--sm" href={`/admin/partenaires/${p.id}`}>Modifier</a>
            </div>
          </div>
        ))}
      </div>
    )
  }
</AdminLayout>
