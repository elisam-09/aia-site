---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BiField from '../../../components/admin/BiField.astro';
import AdminField from '../../../components/admin/AdminField.astro';
import ImageField from '../../../components/admin/ImageField.astro';
import FormActions from '../../../components/admin/FormActions.astro';
import * as repo from '../../../server/db/repo';
import { str, int } from '../../../server/formutil';
import { imageFromForm } from '../../../server/media';

const idParam = Astro.params.id!;
const creation = idParam === 'nouveau';
const id = creation ? 0 : Number(idParam);
const row = creation ? undefined : repo.getPartenaire(id);
if (!creation && !row) return Astro.redirect('/admin/partenaires');

let erreur = '';
let v = {
  nom: row?.nom ?? '',
  sigle: row?.sigle ?? '',
  description_fr: row?.description_fr ?? '',
  description_en: row?.description_en ?? '',
  logo: row?.logo ?? '',
  site: row?.site ?? '',
  ordre: row?.ordre ?? 10,
};

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  if (fd.get('_action') === 'supprimer' && !creation) {
    repo.deletePartenaire(id);
    return Astro.redirect('/admin/partenaires?ok=supprime');
  }
  const logo = await imageFromForm(fd, 500);
  v = {
    nom: str(fd, 'nom'),
    sigle: str(fd, 'sigle'),
    description_fr: str(fd, 'description_fr'),
    description_en: str(fd, 'description_en'),
    logo: logo ?? '',
    site: str(fd, 'site'),
    ordre: int(fd, 'ordre', 10),
  };
  if (!v.nom) erreur = 'Le nom du partenaire est obligatoire.';
  else {
    const data = {
      nom: v.nom,
      sigle: v.sigle || null,
      description_fr: v.description_fr || null,
      description_en: v.description_en || null,
      logo: v.logo || null,
      site: v.site || null,
      ordre: v.ordre,
    };
    if (creation) repo.createPartenaire(data);
    else repo.updatePartenaire(id, data);
    return Astro.redirect(`/admin/partenaires?ok=${creation ? 'cree' : 'enregistre'}`);
  }
}

const titre = creation ? 'Nouveau partenaire' : 'Modifier le partenaire';
---

<AdminLayout title={titre}>
  {erreur && <div class="alerte alerte--erreur">{erreur}</div>}

  <form class="formulaire panneau" method="POST" enctype="multipart/form-data">
    <div class="ligne-champs">
      <AdminField label="Nom complet" name="nom" value={v.nom} required placeholder="Ex. Union Astronomique Internationale" />
      <AdminField label="Sigle" name="sigle" value={v.sigle} placeholder="Ex. UAI" help="Affiché en pastille sur l'accueil." />
    </div>
    <BiField label="Description du partenariat" name="description" type="textarea" fr={v.description_fr} en={v.description_en} />
    <ImageField value={v.logo} label="Logo (optionnel)" />
    <div class="ligne-champs">
      <AdminField label="Site officiel (optionnel)" name="site" type="url" value={v.site} placeholder="https://…" />
      <AdminField label="Ordre d'affichage" name="ordre" type="number" value={String(v.ordre)} />
    </div>
    <FormActions editing={!creation} retour="/admin/partenaires" />
  </form>

  {
    !creation && (
      <form method="POST" onsubmit="return confirm('Supprimer ce partenaire définitivement ?')" style="margin-top:1.4rem">
        <input type="hidden" name="_action" value="supprimer" />
        <button class="bouton bouton--danger" type="submit">Supprimer ce partenaire</button>
      </form>
    )
  }
</AdminLayout>
