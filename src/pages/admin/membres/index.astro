---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import * as repo from '../../../server/db/repo';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const sens = fd.get('_action') === 'monter' ? -1 : fd.get('_action') === 'descendre' ? 1 : 0;
  if (sens) repo.deplacerMembre(Number(fd.get('id')), sens);
  return Astro.redirect('/admin/membres');
}

const membres = repo.listMembres();
const initiales = (n: string) =>
  n.replace(/^(Dr|Pr|Prof)\.?\s+/i, '').split(/\s+/).slice(0, 2).map((m) => m[0]?.toUpperCase() ?? '').join('');
---

<AdminLayout title="Équipe" description="Utilise les flèches pour changer l’ordre d’affichage sur la page « Qui sommes-nous ».">
  <Fragment slot="actions">
    <a class="bouton bouton--primaire" href="/admin/membres/nouveau">+ Nouveau membre</a>
  </Fragment>

  {
    membres.length === 0 ? (
      <div class="lignes"><p class="vide"><b>Aucun membre</b>Ajoute le président et les membres du bureau.</p></div>
    ) : (
      <div class="lignes">
        {membres.map((m, i) => (
          <div class="ligne">
            {m.photo && !m.photo.endsWith('.svg') ? (
              <img class="vignette vignette--rond" src={m.photo} alt="" />
            ) : (
              <span class="vignette vignette--rond">{initiales(m.nom)}</span>
            )}
            <div>
              <h3><a href={`/admin/membres/${m.id}`}>{m.nom}</a></h3>
              <div class="meta">
                {m.badge && <span class="pastille venir">{m.badge}</span>}
                <span>{m.role_fr ?? '—'}</span>
              </div>
            </div>
            <div class="ac">
              <form method="POST">
                <input type="hidden" name="id" value={m.id} />
                <button class="bouton bouton--contour bouton--icone" name="_action" value="monter" disabled={i === 0} aria-label={`Monter ${m.nom}`}>↑</button>
                <button class="bouton bouton--contour bouton--icone" name="_action" value="descendre" disabled={i === membres.length - 1} aria-label={`Descendre ${m.nom}`}>↓</button>
              </form>
              <a class="bouton bouton--contour bouton--sm" href={`/admin/membres/${m.id}`}>Modifier</a>
            </div>
          </div>
        ))}
      </div>
    )
  }
</AdminLayout>
