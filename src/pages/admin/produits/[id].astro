---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BiField from '../../../components/admin/BiField.astro';
import AdminField from '../../../components/admin/AdminField.astro';
import ImageField from '../../../components/admin/ImageField.astro';
import FormActions from '../../../components/admin/FormActions.astro';
import * as repo from '../../../server/db/repo';
import { str, bool, int } from '../../../server/formutil';
import { imageFromForm } from '../../../server/media';

const idParam = Astro.params.id!;
const creation = idParam === 'nouveau';
const id = creation ? 0 : Number(idParam);
const row = creation ? undefined : repo.getProduit(id);
if (!creation && !row) return Astro.redirect('/admin/produits');

let erreur = '';
let v = {
  nom_fr: row?.nom_fr ?? '',
  nom_en: row?.nom_en ?? '',
  description_fr: row?.description_fr ?? '',
  description_en: row?.description_en ?? '',
  image: row?.image ?? '',
  prix: row?.prix ?? '',
  disponible: row ? row.disponible : 1,
  ordre: row?.ordre ?? 10,
};

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  if (fd.get('_action') === 'supprimer' && !creation) {
    repo.deleteProduit(id);
    return Astro.redirect('/admin/produits');
  }
  const image = await imageFromForm(fd, 900);
  v = {
    nom_fr: str(fd, 'nom_fr'),
    nom_en: str(fd, 'nom_en'),
    description_fr: str(fd, 'description_fr'),
    description_en: str(fd, 'description_en'),
    image: image ?? '',
    prix: str(fd, 'prix'),
    disponible: bool(fd, 'disponible'),
    ordre: int(fd, 'ordre', 10),
  };
  if (!v.nom_fr) erreur = 'Le nom (français) est obligatoire.';
  else {
    const data = {
      nom_fr: v.nom_fr,
      nom_en: v.nom_en || null,
      description_fr: v.description_fr || null,
      description_en: v.description_en || null,
      image: v.image || null,
      prix: v.prix || null,
      disponible: v.disponible,
      ordre: v.ordre,
    };
    if (creation) repo.createProduit(data);
    else repo.updateProduit(id, data);
    return Astro.redirect('/admin/produits');
  }
}

const titre = creation ? 'Nouveau produit' : 'Modifier le produit';
---

<AdminLayout title={titre}>
  {erreur && <div class="alerte alerte--erreur">{erreur}</div>}

  <form class="formulaire panneau" method="POST" enctype="multipart/form-data">
    <ImageField value={v.image} label="Photo du produit" />
    <BiField label="Nom du produit" name="nom" fr={v.nom_fr} en={v.nom_en} required />
    <BiField label="Description" name="description" type="textarea" fr={v.description_fr} en={v.description_en} />
    <div class="ligne-champs">
      <AdminField label="Prix indicatif" name="prix" value={v.prix} placeholder="Ex. 7 000 FCFA" help="Aucun paiement en ligne." />
      <AdminField label="Ordre d'affichage" name="ordre" type="number" value={String(v.ordre)} />
    </div>
    <label class="case">
      <input type="checkbox" name="disponible" value="1" checked={Boolean(v.disponible)} /> Disponible
    </label>
    <FormActions editing={!creation} retour="/admin/produits" />
  </form>

  {
    !creation && (
      <form method="POST" onsubmit="return confirm('Supprimer ce produit définitivement ?')" style="margin-top:1.4rem">
        <input type="hidden" name="_action" value="supprimer" />
        <button class="bouton bouton--danger" type="submit">Supprimer ce produit</button>
      </form>
    )
  }
</AdminLayout>
