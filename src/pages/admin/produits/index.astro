---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import * as repo from '../../../server/db/repo';

const produits = repo.listProduits();
---

<AdminLayout title="Produits" description="Les articles de la page Support (boutique de l’association).">
  <Fragment slot="actions">
    <a class="bouton bouton--primaire" href="/admin/produits/nouveau">+ Nouveau produit</a>
  </Fragment>

  {
    produits.length === 0 ? (
      <div class="lignes"><p class="vide"><b>Aucun produit</b>Ajoute un t-shirt, un poster ou des stickers.</p></div>
    ) : (
      <div class="lignes">
        {produits.map((p) => (
          <div class="ligne">
            {p.image ? <img class="vignette" src={p.image} alt="" /> : <span class="vignette">{p.nom_fr.slice(0, 1)}</span>}
            <div>
              <h3><a href={`/admin/produits/${p.id}`}>{p.nom_fr}</a></h3>
              <div class="meta">
                <span class:list={['pastille', p.disponible ? 'oui' : 'non']}>{p.disponible ? 'Disponible' : 'Épuisé'}</span>
                {p.prix && <span>{p.prix}</span>}
              </div>
            </div>
            <div class="ac">
              <a class="bouton bouton--contour bouton--sm" href={`/admin/produits/${p.id}`}>Modifier</a>
            </div>
          </div>
        ))}
      </div>
    )
  }
</AdminLayout>
