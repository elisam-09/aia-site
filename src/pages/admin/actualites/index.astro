---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import * as repo from '../../../server/db/repo';

const actus = repo.listActualites();
---

<AdminLayout title="Actualités">
  <div class="panneau">
    <div class="liste-entete">
      <p style="margin:0;color:var(--adm-muet)">{actus.length} article(s)</p>
      <a class="bouton bouton--primaire" href="/admin/actualites/nouveau">+ Écrire une actualité</a>
    </div>

    {
      actus.length === 0 ? (
        <p style="color:var(--adm-muet)">Aucun article pour l'instant.</p>
      ) : (
        <div class="table-wrap">
          <table class="liste">
            <thead>
              <tr><th>Image</th><th>Date</th><th>Titre</th><th>Auteur</th><th>Statut</th><th /></tr>
            </thead>
            <tbody>
              {actus.map((a) => (
                <tr>
                  <td>
                    <img class="liste__vignette" src={a.image || '/placeholders/recherche.svg'} alt="" />
                  </td>
                  <td>{new Date(a.date).toLocaleDateString('fr-FR')}</td>
                  <td>{a.titre_fr}</td>
                  <td style="color:var(--adm-muet)">{a.auteur}</td>
                  <td>
                    {a.publie ? (
                      <span class="pastille oui">Publié</span>
                    ) : (
                      <span class="pastille non">Brouillon</span>
                    )}
                  </td>
                  <td class="liste__actions">
                    <a class="bouton bouton--contour bouton--sm" href={`/admin/actualites/${a.id}`}>
                      Modifier
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</AdminLayout>
