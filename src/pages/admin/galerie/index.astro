---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import * as repo from '../../../server/db/repo';

const photos = repo.listGalerie();
const libelle: Record<string, string> = {
  astrophoto: 'Astrophoto',
  observation: 'Observation',
  evenement: 'Événement',
  ecole: 'École',
};
const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<AdminLayout title="Galerie" description="Les photos de la page Galerie, classées par catégorie.">
  <Fragment slot="actions">
    <a class="bouton bouton--primaire" href="/admin/galerie/nouveau">+ Ajouter une photo</a>
  </Fragment>

  {
    photos.length === 0 ? (
      <div class="lignes"><p class="vide"><b>Aucune photo</b>Ajoute les photos des observations, conférences et tournées.</p></div>
    ) : (
      <div class="lignes">
        {photos.map((p) => (
          <div class="ligne">
            <img class="vignette" src={p.image} alt="" />
            <div>
              <h3><a href={`/admin/galerie/${p.id}`}>{p.titre_fr}</a></h3>
              <div class="meta">
                <span class="pastille">{libelle[p.categorie] ?? p.categorie}</span>
                {p.date && <span>{fmt(p.date)}</span>}
              </div>
            </div>
            <div class="ac">
              <a class="bouton bouton--contour bouton--sm" href={`/admin/galerie/${p.id}`}>Modifier</a>
            </div>
          </div>
        ))}
      </div>
    )
  }
</AdminLayout>
