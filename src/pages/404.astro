---
import Base from '../layouts/Base.astro';
import { routes } from '../i18n/ui';

// En mode serveur, on renvoie bien le vrai code HTTP 404
Astro.response.status = 404;
---

<Base lang="fr" pageId="home" title="Page introuvable — 404">
  <section class="container perdu">
    <p class="perdu__code">404</p>
    <h1>Cette planète n’existe pas encore</h1>
    <p class="lead">
      Le signal s’est perdu quelque part entre deux orbites. Revenons vers une zone habitée.
    </p>
    <div class="perdu__actions">
      <a class="btn btn-primaire" href={routes.home.fr}>Retour à l’accueil</a>
      <a class="btn btn-contour" href={routes.contact.fr}>Signaler le problème</a>
    </div>
    <p class="perdu__en"><a href="/en/">English version →</a></p>
  </section>
</Base>

<style>
  .perdu {
    min-height: 68vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-block: 4rem;
  }

  .perdu__code {
    font-family: var(--font-hud);
    font-size: clamp(4rem, 16vw, 9rem);
    line-height: 1;
    letter-spacing: 0.1em;
    background: linear-gradient(135deg, var(--ci-orange), var(--creme));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin: 0;
  }

  .perdu__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 1.6rem;
  }

  .perdu__en {
    margin-top: 2rem;
  }

  .perdu__en a {
    color: var(--creme-45);
    text-decoration: none;
    font-family: var(--font-hud);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }
</style>
