---
/**
 * Curseur fusée : suit la souris avec inertie, s'oriente dans le sens du déplacement,
 * flamme proportionnelle à la vitesse ; devient une étoile au survol des éléments cliquables.
 * Désactivé sur écran tactile et si l'utilisateur réduit les animations.
 * (Idée et dessin d'origine : site AIA de Jcalixte24, recolorés aux couleurs AIA.)
 */
---

<div id="curseur" aria-hidden="true">
  <svg class="fusee" viewBox="0 0 40 40">
    <g class="flamme">
      <path d="M16.5 27 Q20 44 23.5 27Z" fill="#F77F00"></path>
      <path d="M18.3 27 Q20 37 21.7 27Z" fill="#FFD3A1"></path>
    </g>
    <path d="M15 21 L8 30 L15 27.5Z M25 21 L32 30 L25 27.5Z" fill="#009E60"></path>
    <path d="M20 2 C26.5 8.5 27.5 18 25.5 27.5 H14.5 C12.5 18 13.5 8.5 20 2Z" fill="#F8F7F8"></path>
    <path d="M20 2 C23 5 24.5 8 25 11 H15 C15.5 8 17 5 20 2Z" fill="#F77F00"></path>
    <circle cx="20" cy="16" r="3.2" fill="#291928" stroke="#F77F00" stroke-width="1.5"></circle>
  </svg>
  <svg class="etoile" viewBox="0 0 40 40">
    <path
      d="M20 2 L24.5 14.5 L38 15.5 L27.5 24 L31 37 L20 29.5 L9 37 L12.5 24 L2 15.5 L15.5 14.5Z"
      fill="#F77F00"
      stroke="#FFD3A1"
      stroke-width="1"
      stroke-linejoin="round"></path>
  </svg>
</div>

<style is:global>
  #curseur {
    position: fixed;
    left: 0;
    top: 0;
    width: 42px;
    height: 42px;
    z-index: 300;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
    will-change: transform;
  }
  #curseur svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  #curseur .fusee {
    transform-origin: 50% 55%;
    filter: drop-shadow(0 0 7px rgba(247, 127, 0, 0.55));
    transition: opacity 0.25s, scale 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  #curseur .flamme {
    transform-box: fill-box;
    transform-origin: 50% 0;
    transform: scaleY(var(--f, 0.4));
    animation: curseur-flamme 0.14s infinite alternate;
  }
  #curseur .etoile {
    opacity: 0;
    scale: 0.3;
    filter: drop-shadow(0 0 10px rgba(247, 127, 0, 0.9));
    transition: opacity 0.25s, scale 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  #curseur.survol .fusee {
    opacity: 0;
    scale: 0.5;
  }
  #curseur.survol .etoile {
    opacity: 1;
    scale: 1.25;
    animation: curseur-tourne 5s linear infinite;
  }
  @keyframes curseur-flamme {
    to {
      opacity: 0.72;
    }
  }
  @keyframes curseur-tourne {
    to {
      rotate: 360deg;
    }
  }
  html.curseur-fusee,
  html.curseur-fusee * {
    cursor: none !important;
  }
  html.curseur-fusee input,
  html.curseur-fusee textarea,
  html.curseur-fusee select,
  html.curseur-fusee [contenteditable] {
    cursor: text !important;
  }
  @media (hover: none) {
    #curseur {
      display: none;
    }
  }
</style>

<script>
  const el = document.getElementById('curseur');
  const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduit && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const fusee = el.querySelector<SVGElement>('.fusee')!;
    let px = -100, py = -100, tx = -100, ty = -100, ang = 0, cible = 0, vitesse = 0, parti = false;

    addEventListener('mousemove', (e) => {
      tx = e.clientX;
      ty = e.clientY;
      if (!parti) {
        parti = true;
        px = tx;
        py = ty;
        el.style.opacity = '1';
        document.documentElement.classList.add('curseur-fusee');
        requestAnimationFrame(boucle);
      }
    });
    document.addEventListener('mouseleave', () => (el.style.opacity = '0'));
    document.addEventListener('mouseenter', () => parti && (el.style.opacity = '1'));
    document.addEventListener('mouseover', (e) => {
      const t = e.target as Element | null;
      el.classList.toggle(
        'survol',
        !!t?.closest?.('a, button, summary, label, select, [role="button"], [data-curseur]'),
      );
    });

    function boucle() {
      const dx = tx - px, dy = ty - py;
      px += dx * 0.22;
      py += dy * 0.22;
      const v = Math.hypot(dx, dy);
      vitesse += (v - vitesse) * 0.2;
      if (v > 2.2) cible = (Math.atan2(dx, -dy) * 180) / Math.PI;
      ang += (((cible - ang + 540) % 360) - 180) * 0.18;
      el!.style.transform = `translate(${px - 21}px, ${py - 21}px)`;
      fusee.style.transform = `rotate(${ang}deg)`;
      fusee.style.setProperty('--f', Math.min(1.7, 0.35 + vitesse / 7).toFixed(2));
      requestAnimationFrame(boucle);
    }
  }
</script>
