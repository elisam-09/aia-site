---
import PageIntro from './PageIntro.astro';
import FormBlock from './FormBlock.astro';
import { useT, type Lang } from '../i18n/ui';
import { WHATSAPP, FACEBOOK } from '../lib/contact';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

const C = {
  fr: {
    eyebrow: "Rejoindre l'AIA",
    titre: 'Veux-tu rejoindre l’aventure toi aussi ?',
    lead: "Pas besoin de télescope, pas besoin de diplôme d'astrophysique. Juste l'envie de comprendre ce qui brille au-dessus de nos têtes.",
    avantagesTitre: 'Ce qui t’attend',
    avantages: [
      { icone: '🔭', t: 'Les télescopes de l’association', p: 'Formation au matériel et accès aux soirées d’observation membres.' },
      { icone: '☄️', t: 'Les campagnes de recherche', p: 'Participe aux campagnes IASC (UAI/NASA) et pars à la chasse aux astéroïdes.' },
      { icone: '📚', t: 'Formations & conférences', p: 'Ateliers d’initiation, astrophotographie, accès privilégié aux AstroPause.' },
      { icone: '🤝', t: 'Une communauté', p: 'Une quarantaine de passionnés, étudiants, enseignants, curieux — et bientôt toi.' },
    ],
    etapesTitre: 'Comment ça se passe',
    etapes: [
      'Tu remplis le formulaire ci-dessous (2 minutes, promis).',
      'Le bureau te recontacte et t’invite à une prochaine activité pour faire connaissance.',
      'Tu deviens membre et l’univers devient un peu plus le tien.',
    ],
    formSujet: "Candidature — Rejoindre l'AIA",
    formTitre: 'Ta candidature',
    femmes: 'Jeunes femmes : les filières scientifiques ont besoin de vous, et l’AIA vous fait une place particulière. Osez.',
    faqTitre: 'Questions fréquentes',
    faq: [
      ['Faut-il un télescope pour participer ?', "Non. Les observations publiques se font avec les télescopes de l'AIA, et on commence très bien à l'œil nu."],
      ['À quoi servent les cotisations ?', "À acheter du matériel (télescopes, équipements d'observation) et à financer les activités, l'AIA manquant de financement public."],
      ['Je suis enseignant, puis-je créer un club ?', "Oui. L'AIA accompagne les lycées dans la création de clubs d'astronomie. Écris-nous pour en parler."],
      ['Où ont lieu les observations ?', 'Régulièrement sur le campus de Cocody à Abidjan, et lors des tournées dans les lycées et les villes. Les dates sont annoncées sur la page Facebook.'],
    ],
    rapide: 'Plus rapide ?',
    rapideP: 'Écris directement au bureau sur WhatsApp, ou suis la page Facebook pour ne rater aucune sortie.',
  },
  en: {
    eyebrow: 'Join AIA',
    titre: 'Want to join the adventure too?',
    lead: 'No telescope needed, no astrophysics degree required. Just the urge to understand what shines above our heads.',
    avantagesTitre: 'What awaits you',
    avantages: [
      { icone: '🔭', t: 'The association’s telescopes', p: 'Equipment training and access to members’ observation nights.' },
      { icone: '☄️', t: 'Research campaigns', p: 'Take part in IASC campaigns (IAU/NASA) and hunt for asteroids.' },
      { icone: '📚', t: 'Training & lectures', p: 'Introductory workshops, astrophotography, priority access to AstroPause.' },
      { icone: '🤝', t: 'A community', p: 'Some forty enthusiasts — students, teachers, curious minds — and soon, you.' },
    ],
    etapesTitre: 'How it works',
    etapes: [
      'Fill in the form below (2 minutes, promise).',
      'The board gets back to you and invites you to an upcoming activity.',
      'You become a member and the universe becomes a little more yours.',
    ],
    formSujet: 'Application — Join AIA',
    formTitre: 'Your application',
    femmes: 'Young women: science needs you, and AIA makes a special place for you. Dare.',
    faqTitre: 'Frequently asked questions',
    faq: [
      ['Do I need a telescope to take part?', 'No. Public stargazing uses AIA’s telescopes, and the naked eye is a great place to start.'],
      ['What are membership fees for?', 'Buying equipment (telescopes, observing gear) and funding activities, as AIA lacks public funding.'],
      ['I am a teacher — can I start a club?', 'Yes. AIA helps high schools set up astronomy clubs. Write to us to talk about it.'],
      ['Where do observations take place?', 'Regularly on the Cocody campus in Abidjan, and during tours of schools and cities. Dates are announced on the Facebook page.'],
    ],
    rapide: 'In a hurry?',
    rapideP: 'Message the board directly on WhatsApp, or follow the Facebook page so you never miss an outing.',
  },
}[lang];
---

<PageIntro eyebrow={C.eyebrow} titre={C.titre} lead={C.lead} />

<section class="container">
  <h2 class="section-title">{C.avantagesTitre}</h2>
  <div class="grid-2">
    {
      C.avantages.map((a) => (
        <article class="avantage">
          <span class="avantage__icone" aria-hidden="true">{a.icone}</span>
          <div>
            <h3>{a.t}</h3>
            <p>{a.p}</p>
          </div>
        </article>
      ))
    }
  </div>

  <p class="encart-femmes">✨ {C.femmes}</p>
</section>

<section class="container bloc-etapes">
  <h2 class="section-title">{C.etapesTitre}</h2>
  <ol class="etapes">
    {C.etapes.map((e) => <li>{e}</li>)}
  </ol>
</section>

<section class="container bloc-form" id="formulaire">
  <h2 class="section-title">{C.formTitre}</h2>
  <FormBlock
    lang={lang}
    id="adhesion"
    sujet={C.formSujet}
    bouton={t('form.envoyer')}
    champs={[
      { name: 'nom', label: t('form.nom'), requis: true },
      { name: 'email', label: t('form.email'), type: 'email', requis: true },
      { name: 'telephone', label: t('form.tel'), type: 'tel' },
      { name: 'ville', label: t('form.ville') },
      { name: 'motivation', label: t('form.motivation'), type: 'textarea', requis: true },
    ]}
  />
</section>

<section class="container bloc-faq">
  <div>
    <h2 class="section-title">{C.faqTitre}</h2>
    {
      C.faq.map(([q, r]) => (
        <details class="faq">
          <summary>{q}</summary>
          <p>{r}</p>
        </details>
      ))
    }
  </div>
  <aside class="rapide">
    <h3>{C.rapide}</h3>
    <p>{C.rapideP}</p>
    <a class="btn btn-vert" href={WHATSAPP} target="_blank" rel="noopener">WhatsApp</a>
    <a class="btn btn-contour" href={FACEBOOK} target="_blank" rel="noopener">Facebook</a>
  </aside>
</section>

<style>
  .bloc-faq {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(3rem, 8vh, 5rem);
  }

  @media (min-width: 900px) {
    .bloc-faq {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }
  }

  .faq {
    border-top: 1px solid var(--creme-12);
    padding: 1rem 0;
  }

  .faq:last-of-type {
    border-bottom: 1px solid var(--creme-12);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-titre);
    font-weight: 600;
    color: var(--creme);
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    font-size: 1.5rem;
    color: var(--ci-orange);
    transition: transform var(--transition);
  }

  .faq[open] summary::after {
    transform: rotate(45deg);
  }

  .faq p {
    margin: 0.6rem 0 0;
    color: var(--creme-70);
  }

  .rapide {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    padding: 1.6rem;
    border: 1px solid var(--ci-orange);
    border-radius: var(--rayon);
    background: linear-gradient(135deg, rgba(247, 127, 0, 0.12), transparent);
  }

  .rapide h3,
  .rapide p {
    flex-basis: 100%;
    margin: 0;
  }

  .rapide p {
    color: var(--creme-70);
    margin-bottom: 0.4rem;
  }

  .avantage {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    border: 1px solid var(--creme-12);
    border-radius: var(--rayon);
    padding: 1.3rem;
    background: rgba(248, 247, 248, 0.03);
  }

  .avantage__icone {
    font-size: 1.7rem;
    line-height: 1;
  }

  .avantage h3 {
    font-size: 1.05rem;
    margin-bottom: 0.3rem;
  }

  .avantage p {
    color: var(--creme-70);
    font-size: 0.92rem;
    margin: 0;
  }

  .encart-femmes {
    margin-top: 1.6rem;
    border-left: 3px solid var(--ci-vert);
    padding: 0.8rem 1.2rem;
    background: rgba(0, 158, 96, 0.07);
    border-radius: 0 var(--rayon-sm) var(--rayon-sm) 0;
    color: var(--creme-2);
    max-width: 46rem;
  }

  .bloc-etapes,
  .bloc-form {
    margin-top: clamp(2.5rem, 7vh, 4rem);
  }

  .etapes {
    counter-reset: etape;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    max-width: 46rem;
  }

  .etapes li {
    counter-increment: etape;
    position: relative;
    padding-left: 3.4rem;
    color: var(--creme-2);
  }

  .etapes li::before {
    content: counter(etape, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.05rem;
    font-family: var(--font-hud);
    font-size: 0.85rem;
    color: var(--ci-orange-vif);
    border: 1px solid rgba(247, 127, 0, 0.45);
    border-radius: 999px;
    padding: 0.3rem 0.55rem;
  }
</style>
