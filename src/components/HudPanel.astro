---
/**
 * Bloc « données de mission » affiché dans un coin de chaque couche de l'accueil.
 * Style HUD d'interface spatiale : monospace, cadres fins, coches d'angle.
 */
interface Props {
  titre: string;
  lignes: { label: string; valeur: string }[];
  classe?: string;
}

const { titre, lignes, classe = '' } = Astro.props;
---

<aside class:list={['hud', classe]} aria-label={titre}>
  <p class="hud__titre">{titre}</p>
  <dl>
    {
      lignes.map((l) => (
        <div class="hud__ligne">
          <dt>{l.label}</dt>
          <dd>{l.valeur}</dd>
        </div>
      ))
    }
  </dl>
</aside>

<style>
  .hud {
    position: relative;
    font-family: var(--font-hud);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--creme-70);
    border: 1px solid var(--creme-12);
    background: rgba(18, 10, 18, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 0.85rem 1rem 0.7rem;
    max-width: 21rem;
  }

  /* Coches d'angle façon viseur */
  .hud::before,
  .hud::after {
    content: '';
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: var(--ci-orange);
    border-style: solid;
  }

  .hud::before {
    top: -1px;
    left: -1px;
    border-width: 2px 0 0 2px;
  }

  .hud::after {
    bottom: -1px;
    right: -1px;
    border-width: 0 2px 2px 0;
  }

  .hud__titre {
    margin: 0 0 0.5rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--creme);
    font-size: 0.68rem;
  }

  .hud__titre::before {
    content: '● ';
    color: var(--ci-vert);
    animation: pulser 2.4s ease-in-out infinite;
  }

  @keyframes pulser {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  dl {
    margin: 0;
  }

  .hud__ligne {
    display: flex;
    justify-content: space-between;
    gap: 1.2rem;
    padding-block: 0.18rem;
    border-top: 1px dashed var(--creme-06);
  }

  dt {
    color: var(--creme-45);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  dd {
    margin: 0;
    color: var(--creme-2);
    text-align: right;
  }
</style>
