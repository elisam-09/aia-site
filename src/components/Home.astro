---
/**
 * Page d'accueil — la « descente » : espace profond → système solaire → ceinture
 * → orbite → atmosphère → ciel d'Abidjan. Une seule source pour FR et EN.
 *
 * Effets (accueil.ts) : télescope 3D qui se décompose au défilement, manifeste révélé mot à mot,
 * compteurs, globe 3D centré sur Abidjan, Lune du jour, éclipse, accordéon d'activités.
 * Tout reste lisible sans JavaScript, sans WebGL ou avec « réduire les animations ».
 */
import HudPanel from './HudPanel.astro';
import Card from './Card.astro';
import SolarSystem from './solar/SolarSystem';
import logo from '../assets/logo-aia-blanc.png';
import { Image } from 'astro:assets';
import { useT, routes, formatDate, type Lang } from '../i18n/ui';
import { getUpcomingEvents, getPastEvents, getPosts, getPartners } from '../lib/content';
import { COPY } from './accueil/copy';
import '../scripts/eclipse/eclipse-teaser.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const c = COPY[lang];

const evenements = await getUpcomingEvents(lang, 3);
const passes = (await getPastEvents(lang)).slice(0, 8);
const articles = (await getPosts(lang)).slice(0, 3);
const partenaires = await getPartners(lang);

const rechercheUrl =
  lang === 'fr'
    ? routes.activities.fr + '#recherche-asteroides'
    : routes.activities.en + '#asteroid-search';
const fmtStat = (n: number) => n.toLocaleString(lang === 'fr' ? 'fr-FR' : 'en-GB');
---

<!-- Écran d'arrivée : le logo dans le réticule (une fois par session) -->
<div id="splash" aria-hidden="true">
  <div class="splash__reticule">
    <svg viewBox="0 0 180 180">
      <circle class="splash__anneau splash__anneau--1" cx="90" cy="90" r="86"></circle>
      <circle class="splash__anneau splash__anneau--2" cx="90" cy="90" r="78"></circle>
    </svg>
    <Image src={logo} alt="" width="136" height="136" class="splash__logo" loading="eager" />
    <div class="splash__txt">{c.splash}</div>
  </div>
</div>
<script is:inline>
  // masque le texte du hero avant la première peinture (révélé ensuite par GSAP)
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('anim');
  try {
    if (sessionStorage.getItem('aia-splash')) document.getElementById('splash').remove();
    else sessionStorage.setItem('aia-splash', '1');
  } catch (e) {}
</script>

<!-- Altimètre de la descente -->
<div class="rail" aria-hidden="true">
  <span>{c.rail}</span><span class="rail__alt" id="rail-alt">∞</span>
  <div class="rail__barre"><i id="rail-point"></i></div>
</div>

<!-- ═══════════ Couche 1 · Espace profond : le télescope ═══════════ -->
<section class="couche couche--espace" id="espace" data-alt="∞">
  <div class="scene" id="scene">
    <canvas class="scene__canvas" id="telescope" aria-hidden="true"></canvas>
    <div class="scene__vignette"></div>

    <div class="hero" id="hero">
      <Image src={logo} alt="" width="132" height="132" class="hero__logo" loading="eager" />
      <p class="eyebrow">{c.hero.eyebrow}</p>
      <h1 class="hero__titre">
        <span class="masque"><span>{c.hero.h1[0]}</span></span>
        <span class="masque"><span>{c.hero.h1[1]}</span></span>
      </h1>
      <p class="lead hero__lead rv">{c.hero.lead}</p>
      <div class="hero__actions rv">
        <a class="btn btn-primaire" href="#systeme">{c.hero.cta} ↓</a>
        <a class="btn btn-contour" href={routes.join[lang]}>{t('nav.join')}</a>
      </div>
    </div>

    <div class="etiqs" aria-hidden="true">
      {
        c.hero.pieces.map(([nom, desc], i) => (
          <div class="etiq" data-i={i}>
            <i class="etiq__ligne" />
            <i class="etiq__point" />
            <small>0{i + 1}</small>
            <b>{nom}</b>
            <span>{desc}</span>
          </div>
        ))
      }
    </div>
    <div class="scene__final" id="final">
      <div><h2>{c.hero.final[0]}</h2><p>{c.hero.final[1]}</p></div>
    </div>
    <div class="scene__flash" id="flash"></div>
    <div class="scene__eclate" id="eclate" data-label={c.hero.eclate}>{c.hero.eclate} · 0 %</div>
    <button class="scene__passer btn btn-contour" id="passer" type="button">{c.hero.passer}</button>
    <div class="scene__indice" id="indice">{c.hero.defiler}<i></i></div>
  </div>
  <HudPanel titre={c.hero.hud.titre} lignes={[...c.hero.hud.lignes]} classe="couche__hud hud-espace" />
</section>

<!-- ═══════════ Couche 2 · Système solaire (navigation) ═══════════ -->
<section class="couche couche--systeme apparait" id="systeme" data-alt="150 M km">
  <div class="container">
    <p class="eyebrow">{c.sys.eyebrow}</p>
    <h2 class="section-title">{c.sys.titre}</h2>
    <p class="lead">{t('solar.hint')}</p>
  </div>
  <div class="container systeme__scene">
    <SolarSystem
      client:visible
      lang={lang}
      labels={{ aria: t('solar.aria'), to3d: t('solar.mode3d'), to2d: t('solar.mode2d') }}
    />
  </div>
  <HudPanel titre={c.sys.hud.titre} lignes={[...c.sys.hud.lignes]} classe="couche__hud" />
</section>

<!-- ═══════════ Manifeste + chiffres ═══════════ -->
<section class="manifeste" id="manifeste">
  <div class="container">
    <p class="manifeste__texte" id="manifeste-texte">
      {c.manifeste.avant} <b class="fort">{c.manifeste.fort1}</b>
      {c.manifeste.milieu} <b class="fort">{c.manifeste.fort2}</b>
    </p>
    <div class="stats">
      {
        c.manifeste.stats.map((s) => (
          <div class="stat rv">
            <b data-n={s.n} data-brut={'brut' in s ? '1' : undefined} data-plus={'plus' in s ? '1' : undefined}>
              {('brut' in s ? String(s.n) : fmtStat(s.n)) + ('plus' in s ? '+' : '')}
            </b>
            <span>{s.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- ═══════════ Couche 3 · Ceinture d'astéroïdes ═══════════ -->
<section class="couche couche--ceinture apparait" id="ceinture" data-alt="400 M km">
  <div class="container ceinture__grille">
    <div>
      <p class="eyebrow">{c.ceinture.eyebrow}</p>
      <h2 class="section-title">{c.ceinture.titre}</h2>
      <p>{c.ceinture.p1}</p>
      <p>{c.ceinture.p2}</p>
      <a class="btn btn-primaire" href={rechercheUrl}>{c.ceinture.cta}</a>
    </div>
    <div class="piste" aria-hidden="true">
      {Array.from({ length: 6 }, () => (
        <svg class="caillou" viewBox="0 0 40 40"><path d="M6 20 12 8l14-2 10 12-4 14-16 6z" /></svg>
      ))}
      <div class="piste__cible"><div>6</div><small>{c.ceinture.cible}</small></div>
    </div>
  </div>
  <HudPanel titre={c.ceinture.hud.titre} lignes={[...c.ceinture.hud.lignes]} classe="couche__hud" />
</section>

<!-- ═══════════ Couche 4 · Orbite terrestre ═══════════ -->
<section class="couche couche--orbite apparait" id="orbite" data-alt="400 km">
  <div class="container">
    <p class="eyebrow">{c.orbite.eyebrow}</p>

    <div class="globe-grille">
      <div>
        <h2 class="section-title">{c.orbite.globeTitre}</h2>
        <p class="lead">{c.orbite.globeLead}</p>
        <div class="coords">
          {c.orbite.coords.map(([l, v]) => <div>{l}<b>{v}</b></div>)}
        </div>
      </div>
      <div class="globe" id="globe">
        <canvas id="globe-canvas" role="img" aria-label={c.orbite.globeAria}></canvas>
        <div class="globe__balise" id="globe-balise">ABIDJAN<b>5°21′ N · 4°01′ {lang === 'fr' ? 'O' : 'W'}</b></div>
        <p class="globe__aide">{c.orbite.globeAide}</p>
      </div>
    </div>

    <div class="orbite__entete orbite__entete--second">
      <h2 class="section-title">{c.orbite.titreEvents}</h2>
      <a class="orbite__tout" href={routes.events[lang]}>{t('action.toutVoir')} →</a>
    </div>
    {
      evenements.length > 0 ? (
        <div class="grid-3">
          {evenements.map((e) => (
            <Card
              href={routes.events[lang]}
              image={e.image}
              chip={formatDate(e.date, lang) + (e.heure ? ` · ${e.heure}` : '')}
              titre={e.titre}
              texte={e.description}
              meta={e.lieu}
            />
          ))}
        </div>
      ) : (
        <div class="radar-carte">
          <div class="radar" aria-hidden="true">
            <svg viewBox="0 0 190 190">
              <circle cx="95" cy="95" r="90" /><circle cx="95" cy="95" r="60" /><circle cx="95" cy="95" r="30" />
              <path d="M95 5v180M5 95h180" />
              <g class="radar__balayage"><path d="M95 95 L95 5 A90 90 0 0 1 158 31 Z" /></g>
              <circle class="radar__echo" cx="130" cy="60" r="3" /><circle class="radar__echo" cx="64" cy="120" r="2.5" />
            </svg>
          </div>
          <div>
            <p>{c.orbite.aucun}</p>
            <a class="btn btn-primaire" href={routes.contact[lang]}>{c.orbite.prevenu}</a>
          </div>
        </div>
      )
    }

    {
      passes.length > 0 && (
        <>
          <h3 class="orbite__sous-titre">{c.orbite.archives}</h3>
          <div class="bande" data-glisser>
            {passes.map((e) => (
              <article class="ev">
                <div class="ev__photo">
                  {e.image && <img src={e.image} alt="" loading="lazy" />}
                </div>
                <div class="ev__texte">
                  <time datetime={e.date}>{formatDate(e.date, lang)}</time>
                  <h4>{e.titre}</h4>
                  <p>{e.description}</p>
                  <span class="ev__lieu">{e.lieu}</span>
                </div>
              </article>
            ))}
          </div>
        </>
      )
    }

    <div class="orbite__entete orbite__entete--second">
      <h2 class="section-title">{c.orbite.titreNews}</h2>
      <a class="orbite__tout" href={routes.news[lang]}>{t('action.toutVoir')} →</a>
    </div>
    <div class="grid-3">
      {
        articles.map((a) => (
          <Card
            href={lang === 'fr' ? `/actualites/${a.slug}/` : `/en/news/${a.slug}/`}
            image={a.image}
            chip={formatDate(a.date, lang)}
            chipVert
            titre={a.titre}
            texte={a.extrait}
            lienLabel={t('action.lire')}
          />
        ))
      }
    </div>
  </div>
  <HudPanel titre={c.orbite.hud.titre} lignes={[...c.orbite.hud.lignes]} classe="couche__hud" />
</section>

<div class="defile" aria-hidden="true">
  <div class="defile__piste" id="defile">
    {[...c.defile, ...c.defile].map((m) => <>{m}<b>✦</b></>)}
  </div>
</div>

<!-- ═══════════ Couche 5 · Atmosphère ═══════════ -->
<section class="couche couche--atmosphere apparait" id="atmosphere" data-alt="100 km">
  <div class="container">
    <p class="eyebrow">{c.atmo.eyebrow}</p>
    <h2 class="section-title">{c.atmo.titre}</h2>
    <p class="lead">{c.atmo.lead}</p>
    <div class="accordeon" id="accordeon">
      {
        c.atmo.activites.map((a, i) => (
          <article class:list={['volet', { ouvert: i === 0 }]} tabindex="0" role="button" aria-expanded={i === 0 ? 'true' : 'false'}>
            <img src={a.image} alt={a.alt} loading="lazy" />
            <div class="volet__int">
              <span class="volet__num">0{i + 1}</span>
              <h3>{a.titre}</h3>
              <div class="volet__plus">
                <p>{a.texte}</p>
                <ul>{a.tags.map((tg) => <li>{tg}</li>)}</ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
    <p class="atmo__lien"><a class="orbite__tout" href={routes.activities[lang]}>{c.atmo.toutes} →</a></p>
  </div>
  <HudPanel titre={c.atmo.hud.titre} lignes={[...c.atmo.hud.lignes]} classe="couche__hud" />
</section>

<!-- ═══════════ Ce soir : Lune, ciel, éclipse ═══════════ -->
<section class="couche couche--observer apparait" id="observer" data-alt="10 km">
  <div class="observer__photo" style="background-image:url(/images/photos/abidjan-nuit.webp)"></div>
  <div class="container">
    <p class="eyebrow">{c.observer.eyebrow}</p>
    <h2 class="section-title">{c.observer.titre}</h2>
    <p class="lead">{c.observer.lead}</p>
    <div class="observer__grille" id="lune">
      <div class="lune">
        <canvas class="lune__disque" width="440" height="440" role="img" aria-label={c.observer.luneAria}></canvas>
        <p class="lune__resume" data-lune="resume"></p>
        <button type="button" class="ecl-teaser" id="ecl-teaser" aria-haspopup="dialog" hidden></button>
      </div>
      <div class="ciel-grille">
        {
          c.observer.cases.map(([titre, cle, sous]) => (
            <div class="ciel-case">
              <small>{titre}</small>
              <b data-lune={cle || undefined}>{cle === 'heure' ? '--:--' : cle ? '…' : '≈ 400 km'}</b>
              <span data-lune={cle === 'phase' ? 'age' : undefined}>{sous}</span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="conseils">
      {
        c.observer.conseils.map(([titre, texte], i) => (
          <div class="conseil rv">
            <i>0{i + 1}</i>
            <h3>{titre}</h3>
            <p>{texte}</p>
          </div>
        ))
      }
    </div>
    <p class="credits">{c.observer.credits}</p>
  </div>
</section>

<!-- ═══════════ Couche 6 · Ciel d'Abidjan ═══════════ -->
<section class="couche couche--abidjan apparait" id="abidjan" data-alt="18 m">
  <div class="container abidjan__int">
    <h2 class="abidjan__titre">{c.abidjan.titre}</h2>
    <p class="lead abidjan__p">{c.abidjan.p}</p>
    <div class="abidjan__actions">
      <a class="btn btn-primaire" href={routes.join[lang]}>{c.abidjan.cta1} 🚀</a>
      <a class="btn btn-contour" href={routes.contact[lang]}>{c.abidjan.cta2}</a>
    </div>

    <p class="abidjan__partenaires-titre">{c.abidjan.partenairesTitre}</p>
    <div class="abidjan__partenaires">
      {
        partenaires.map((pa) =>
          pa.logo ? (
            <a class="partenaire-logo" href={pa.site ?? routes.partners[lang]} title={pa.nom} target={pa.site ? '_blank' : undefined} rel="noopener">
              <img src={pa.logo} alt={pa.nom} loading="lazy" />
            </a>
          ) : (
            <a class="partenaire-chip" href={routes.partners[lang]} title={pa.nom}>
              {pa.sigle ?? pa.nom}
            </a>
          ),
        )
      }
    </div>
  </div>
  <HudPanel titre={c.abidjan.hud.titre} lignes={[...c.abidjan.hud.lignes]} classe="couche__hud" />
</section>

<style>
  /* ============ Écran d'arrivée ============ */
  #splash {
    display: none;
  }
  :global(html.js) #splash {
    position: fixed;
    inset: 0;
    z-index: 400;
    display: grid;
    place-items: center;
    background: var(--abysse);
    transition: opacity 0.9s 0.1s, visibility 0.9s 0.1s;
  }
  :global(html.js) #splash.parti {
    opacity: 0;
    visibility: hidden;
  }
  .splash__reticule {
    position: relative;
    width: 180px;
    height: 180px;
  }
  .splash__reticule svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .splash__anneau {
    fill: none;
    stroke: var(--ci-orange);
    stroke-width: 1.2;
    transform-origin: 90px 90px;
  }
  .splash__anneau--1 {
    stroke-dasharray: 4 10;
    animation: tourner 6s linear infinite;
  }
  .splash__anneau--2 {
    stroke: var(--ci-vert);
    stroke-dasharray: 30 12;
    animation: tourner 4s linear infinite reverse;
  }
  .splash__reticule :global(.splash__logo) {
    position: absolute;
    inset: 22px;
    width: 136px;
    height: 136px;
    border-radius: 50%;
    animation: pulser 2.4s ease-in-out infinite;
  }
  .splash__txt {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 26px);
    text-align: center;
    font: 600 0.72rem var(--font-hud);
    letter-spacing: 0.4em;
    color: var(--creme-45);
  }
  @keyframes pulser {
    50% {
      transform: scale(1.08);
      opacity: 0.7;
    }
  }

  /* ============ Altimètre ============ */
  .rail {
    display: none;
  }
  @media (min-width: 1360px) {
    .rail {
      position: fixed;
      left: 22px;
      top: 50%;
      transform: translateY(-50%);
      z-index: 40;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      font: 600 10px var(--font-hud);
      letter-spacing: 0.2em;
      color: var(--creme-45);
    }
  }
  .rail__alt {
    color: var(--ci-orange-vif);
    font-size: 13px;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }
  .rail__barre {
    width: 1px;
    height: 34vh;
    background: var(--creme-12);
    position: relative;
    margin-left: 4px;
  }
  .rail__barre i {
    position: absolute;
    left: -3px;
    top: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ci-orange);
    box-shadow: 0 0 14px var(--ci-orange);
  }

  /* ============ Couches ============ */
  .couche {
    position: relative;
    padding-block: var(--espace-section);
    scroll-margin-top: 64px;
  }
  .couche :global(.couche__hud) {
    margin: 1.8rem auto 0;
    width: min(21rem, calc(100% - 2.5rem));
  }
  @media (min-width: 1200px) {
    .couche :global(.couche__hud) {
      position: absolute;
      top: clamp(1rem, 4vh, 3rem);
      right: 1.4rem;
      margin: 0;
      width: auto;
    }
  }

  /* ============ Couche 1 : scène du télescope ============ */
  .couche--espace {
    padding: 0;
    /* la scène passe sous l'en-tête collant (hauteur mesurée par accueil.ts) */
    margin-top: calc(-1 * var(--entete-h, 0px));
  }
  /* le HUD de l'espace profond est masqué pendant l'intro animée */
  :global(html.anim) .couche--espace :global(.hud-espace) {
    display: none;
  }
  .scene {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .scene__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
  }
  :global(html.webgl) .scene__canvas {
    display: block;
  }
  .scene__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 62% 50%, transparent 38%, rgba(11, 6, 12, 0.78));
  }
  .hero {
    position: relative;
    z-index: 4;
    width: min(var(--largeur-site), 100% - 2.5rem);
    margin-inline: auto;
    padding-block: 7rem 5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-shadow: 0 2px 28px rgba(11, 6, 12, 0.95);
  }
  /* avec le télescope : texte à gauche, télescope à droite */
  :global(html.webgl) .hero {
    align-items: flex-start;
    text-align: left;
  }
  :global(html.webgl) .hero > * {
    max-width: 38rem;
  }
  .hero :global(.hero__logo) {
    border-radius: 50%;
    margin-bottom: 1.6rem;
    filter: drop-shadow(0 0 34px rgba(248, 247, 248, 0.18));
  }
  .hero .eyebrow::after {
    content: '';
    width: 1.6rem;
    height: 2px;
    background: var(--ci-vert);
    border-radius: 2px;
  }
  .hero__titre {
    font-size: var(--taille-hero);
  }
  .masque {
    display: block;
    overflow: hidden;
    padding: 0.06em 0 0.14em;
    margin-bottom: -0.1em;
  }
  .masque > span {
    display: block;
  }
  :global(html.anim) .masque > span {
    transform: translateY(110%);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.9rem;
  }
  :global(html:not(.webgl)) .hero__actions {
    justify-content: center;
  }

  .etiqs {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }
  .etiq {
    position: absolute;
    width: 176px;
    transform: translateX(-50%);
    opacity: 0;
    font-size: 13px;
    line-height: 1.4;
  }
  .etiq small {
    display: block;
    font: 600 10px var(--font-hud);
    letter-spacing: 0.2em;
    color: var(--ci-orange-vif);
  }
  .etiq b {
    display: block;
    font: 700 15px var(--font-titre);
    color: var(--creme);
    margin: 2px 0 4px;
  }
  .etiq span {
    display: block;
    font-size: 12.5px;
    color: var(--creme-70);
  }
  .etiq__ligne {
    position: absolute;
    left: 50%;
    width: 1px;
    background: linear-gradient(var(--ci-orange), rgba(247, 127, 0, 0.15));
  }
  .etiq__point {
    position: absolute;
    left: 50%;
    width: 9px;
    height: 9px;
    margin-left: -4px;
    border-radius: 50%;
    background: var(--ci-orange);
    box-shadow: 0 0 14px var(--ci-orange);
  }
  .scene__final {
    position: absolute;
    inset: 0;
    z-index: 6;
    display: grid;
    place-content: center;
    text-align: center;
    opacity: 0;
    pointer-events: none;
  }
  .scene__final h2 {
    font-size: clamp(3rem, 10vw, 9rem);
    margin: 0;
  }
  .scene__final p {
    color: var(--creme-70);
    font-size: 1.25rem;
  }
  .scene__flash {
    position: absolute;
    inset: 0;
    z-index: 7;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle, #fff 0%, #ffc58a 38%, rgba(247, 127, 0, 0) 72%);
  }
  .scene__eclate,
  .scene__indice {
    position: absolute;
    z-index: 5;
    font: 600 10px var(--font-hud);
    letter-spacing: 0.3em;
    color: var(--creme-45);
  }
  .scene__eclate {
    left: max(1.25rem, calc((100vw - var(--largeur-site)) / 2));
    bottom: 30px;
    opacity: 0;
  }
  .scene__indice {
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    display: none;
  }
  :global(html.anim) .scene__indice {
    display: block;
  }
  .scene__indice i {
    display: block;
    width: 1px;
    height: 46px;
    margin: 10px auto 0;
    background: linear-gradient(var(--ci-orange), transparent);
    animation: goutte 2s infinite;
  }
  @keyframes goutte {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
  .scene__passer {
    position: absolute;
    z-index: 8;
    right: max(1.25rem, calc((100vw - var(--largeur-site)) / 2));
    bottom: 20px;
    padding: 0.5rem 1.1rem;
    font-size: 0.8rem;
    display: none;
  }
  :global(html.anim) .scene__passer {
    display: inline-flex;
  }

  @media (max-width: 980px) {
    :global(html.webgl) .hero {
      align-self: flex-end;
      padding-block: 0 4.4rem;
    }
    :global(html.webgl) .hero :global(.hero__logo) {
      width: 56px;
      height: 56px;
      margin-bottom: 0.8rem;
    }
    :global(html.webgl) .hero .eyebrow {
      font-size: 0.62rem;
      letter-spacing: 0.16em;
      margin-bottom: 0.6rem;
    }
    :global(html.webgl) .hero .eyebrow::after {
      display: none;
    }
    :global(html.webgl) .hero__titre {
      font-size: clamp(2rem, 8.6vw, 3.4rem);
      margin-bottom: 0.3em;
    }
    :global(html.webgl) .hero__lead {
      font-size: 0.95rem;
      line-height: 1.5;
    }
    :global(html.webgl) .hero__actions {
      flex-wrap: nowrap;
      gap: 0.6rem;
      margin-top: 1.1rem;
      width: 100%;
    }
    :global(html.webgl) .hero__actions .btn {
      flex: 1;
      justify-content: center;
      padding: 0.75rem 0.6rem;
      font-size: 0.85rem;
      white-space: nowrap;
    }
    .scene__indice {
      display: none !important;
    }
  }

  /* ============ Couche 2 : système solaire ============ */
  .couche--systeme {
    text-align: center;
  }
  .couche--systeme .eyebrow {
    justify-content: center;
  }
  .couche--systeme .lead {
    margin-inline: auto;
  }
  .systeme__scene {
    margin-top: 1.4rem;
  }

  /* ============ Manifeste ============ */
  .manifeste {
    padding-block: var(--espace-section);
  }
  .manifeste__texte {
    font: 700 clamp(1.7rem, 4.4vw, 3.6rem) / 1.2 var(--font-titre);
    letter-spacing: -0.02em;
    color: var(--creme);
    max-width: 22em;
    margin-bottom: 4rem;
  }
  .manifeste__texte .fort {
    color: var(--ci-orange-vif);
  }
  .manifeste__texte :global(.mot) {
    display: inline-block;
    opacity: 0.14;
    margin-right: 0.26em;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--creme-12);
    border: 1px solid var(--creme-12);
    border-radius: var(--rayon);
    overflow: hidden;
  }
  .stat {
    background: var(--aubergine-950);
    padding: 2rem 1.5rem;
  }
  .stat b {
    display: block;
    font: 700 clamp(2.2rem, 5vw, 3.6rem) / 1 var(--font-titre);
    color: var(--ci-orange);
    font-variant-numeric: tabular-nums;
  }
  .stat span {
    font: 500 0.72rem var(--font-hud);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--creme-70);
  }
  @media (max-width: 760px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ============ Couche 3 : ceinture ============ */
  .ceinture__grille {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .ceinture__grille {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  .piste {
    position: relative;
    height: 360px;
    border: 1px solid var(--creme-12);
    border-radius: var(--rayon);
    overflow: hidden;
    background:
      linear-gradient(rgba(11, 6, 12, 0.35), rgba(11, 6, 12, 0.6)),
      url(/images/photos/orion.webp) center / cover;
  }
  .caillou {
    position: absolute;
    left: -60px;
    fill: var(--creme-3);
    animation: survol linear infinite;
  }
  .caillou:nth-child(1) { top: 20%; width: 36px; animation-duration: 14s; }
  .caillou:nth-child(2) { top: 45%; width: 22px; animation-duration: 9s; animation-delay: -3s; }
  .caillou:nth-child(3) { top: 68%; width: 50px; animation-duration: 20s; animation-delay: -8s; }
  .caillou:nth-child(4) { top: 32%; width: 16px; animation-duration: 7s; animation-delay: -5s; }
  .caillou:nth-child(5) { top: 80%; width: 28px; animation-duration: 12s; animation-delay: -1s; }
  .caillou:nth-child(6) { top: 10%; width: 20px; animation-duration: 16s; animation-delay: -11s; }
  @keyframes survol {
    to {
      transform: translateX(min(100vw, 700px));
    }
  }
  .piste__cible {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .piste__cible div {
    width: 140px;
    height: 140px;
    display: grid;
    place-items: center;
    border: 1px solid var(--ci-orange);
    border-radius: 50%;
    font: 700 4rem var(--font-titre);
    background: linear-gradient(135deg, var(--ci-orange), var(--creme));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: pulser 3s ease-in-out infinite;
  }
  .piste__cible small {
    position: absolute;
    bottom: 18px;
    font: 600 10px var(--font-hud);
    letter-spacing: 0.3em;
    color: var(--creme-70);
  }

  /* ============ Couche 4 : orbite ============ */
  .globe-grille {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .globe-grille {
      grid-template-columns: 1fr 1fr;
    }
  }
  .coords {
    display: flex;
    flex-wrap: wrap;
    gap: 1.8rem;
    margin-top: 2rem;
    font: 600 11px var(--font-hud);
    letter-spacing: 0.18em;
    color: var(--creme-45);
  }
  .coords b {
    display: block;
    margin-top: 4px;
    font: 600 15px var(--font-titre);
    letter-spacing: 0.04em;
    color: var(--creme);
  }
  .globe {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    max-width: 520px;
    justify-self: center;
    cursor: grab;
    touch-action: pan-y;
  }
  .globe:active {
    cursor: grabbing;
  }
  .globe canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .globe__balise {
    position: absolute;
    z-index: 3;
    left: 0;
    top: 0;
    transform: translate(-50%, -135%);
    font: 600 10px var(--font-hud);
    letter-spacing: 0.24em;
    color: var(--ci-orange-vif);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    text-shadow: 0 0 12px var(--abysse);
    transition: opacity 0.3s;
  }
  .globe__balise b {
    display: block;
    margin-top: 2px;
    font-size: 9px;
    color: var(--creme);
    letter-spacing: 0.14em;
  }
  .globe__balise::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 1px;
    height: 16px;
    background: var(--ci-orange);
  }
  .globe__aide {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    margin: 0;
    text-align: center;
    font: 600 10px var(--font-hud);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--creme-45);
  }
  :global(html:not(.webgl)) .globe {
    display: none;
  }

  .orbite__entete {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
  }
  .orbite__entete--second {
    margin-top: 4.5rem;
  }
  .orbite__entete .section-title {
    margin-bottom: 0;
  }
  .orbite__tout {
    white-space: nowrap;
    text-decoration: none;
    font-weight: 600;
    color: var(--ci-orange-vif);
  }
  .orbite__sous-titre {
    margin: 3rem 0 0;
    font-size: var(--taille-h3);
  }

  .radar-carte {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2.5rem;
    align-items: center;
    padding: 2rem;
    border: 1px dashed var(--ci-orange);
    border-radius: var(--rayon);
    background: rgba(247, 127, 0, 0.04);
  }
  .radar-carte p {
    color: var(--creme-70);
    max-width: 52ch;
  }
  .radar {
    width: 160px;
    height: 160px;
  }
  .radar svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--creme-12);
  }
  .radar__balayage {
    transform-origin: 95px 95px;
    animation: tourner 3.5s linear infinite;
  }
  .radar__balayage path {
    fill: var(--ci-orange);
    stroke: none;
    opacity: 0.25;
  }
  .radar__echo {
    fill: var(--ci-orange);
    stroke: none;
  }
  @media (max-width: 640px) {
    .radar-carte {
      grid-template-columns: 1fr;
      justify-items: start;
    }
    .radar {
      width: 120px;
      height: 120px;
    }
  }

  .bande {
    display: flex;
    gap: 1.1rem;
    margin-top: 1.4rem;
    padding-bottom: 1.4rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--ci-orange) transparent;
    cursor: grab;
  }
  .bande:global(.glisse) {
    cursor: grabbing;
    scroll-snap-type: none;
  }
  .bande:global(.glisse) * {
    user-select: none;
    pointer-events: none;
  }
  .ev {
    flex: 0 0 min(360px, 82vw);
    scroll-snap-align: start;
    border: 1px solid var(--creme-12);
    border-radius: var(--rayon);
    overflow: hidden;
    background: rgba(34, 20, 34, 0.75);
    transition: border-color 0.4s, transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ev:hover {
    border-color: var(--ci-orange);
    transform: translateY(-6px);
  }
  .ev__photo {
    height: 200px;
    overflow: hidden;
    background: radial-gradient(circle at 30% 30%, var(--aubergine-600), var(--aubergine-950));
  }
  .ev__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ev:hover .ev__photo img {
    transform: scale(1.07);
  }
  .ev__texte {
    padding: 1.3rem 1.4rem 1.5rem;
  }
  .ev time {
    font: 600 11px var(--font-hud);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ci-orange-vif);
  }
  .ev h4 {
    margin: 0.5rem 0;
    font-size: 1.2rem;
  }
  .ev p {
    font-size: 0.92rem;
    color: var(--creme-70);
    margin-bottom: 0.6rem;
  }
  .ev__lieu {
    font: 600 10px var(--font-hud);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--creme-45);
  }

  /* ============ Bandeau défilant ============ */
  .defile {
    overflow: hidden;
    white-space: nowrap;
    padding: 2rem 0;
    border-block: 1px solid var(--creme-12);
    background: rgba(11, 6, 12, 0.5);
  }
  .defile__piste {
    display: inline-block;
    padding-left: 4vw;
    font: 700 clamp(2.4rem, 7vw, 5.6rem) / 1 var(--font-titre);
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1px var(--creme-25);
  }
  .defile__piste b {
    color: var(--ci-orange);
    -webkit-text-stroke: 0;
    margin: 0 0.3em;
  }

  /* ============ Couche 5 : accordéon d'activités ============ */
  .accordeon {
    display: flex;
    gap: 10px;
    height: min(70vh, 600px);
    margin-top: 2.5rem;
  }
  .volet {
    position: relative;
    flex: 1;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--creme-12);
    cursor: pointer;
    background: var(--aubergine-800);
    transition: flex 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.4s;
  }
  .volet.ouvert {
    flex: 6;
    border-color: var(--ci-orange);
  }
  .volet img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.7) brightness(0.6);
    transform: scale(1.08);
    transition: filter 0.8s, transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .volet.ouvert img {
    filter: saturate(1) brightness(0.85);
    transform: scale(1);
  }
  .volet::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(18, 10, 18, 0.15), rgba(18, 10, 18, 0.92));
  }
  .volet__int {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.6rem 1.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .volet__num {
    font: 700 2.4rem / 1 var(--font-titre);
    color: var(--ci-orange);
  }
  .volet h3 {
    margin: 0;
    font-size: clamp(1.3rem, 2.4vw, 2.1rem);
    white-space: nowrap;
  }
  .volet:not(.ouvert) h3 {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    align-self: flex-start;
    font-size: 1.3rem;
  }
  .volet__plus {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.6s 0.15s;
  }
  .volet.ouvert .volet__plus {
    max-height: 260px;
    opacity: 1;
  }
  .volet__plus p {
    color: var(--creme);
    max-width: 52ch;
    margin: 0.2rem 0 0;
  }
  .volet__plus ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0.9rem 0 0;
    padding: 0;
  }
  .volet__plus li {
    font: 600 10.5px var(--font-hud);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid var(--creme-25);
    padding: 6px 12px;
    border-radius: 999px;
  }
  .atmo__lien {
    margin-top: 1.5rem;
    text-align: right;
  }
  @media (max-width: 760px) {
    .accordeon {
      flex-direction: column;
      height: auto;
      gap: 8px;
    }
    .volet,
    .volet.ouvert {
      flex: none;
    }
    .volet {
      height: 80px;
      transition: height 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.4s;
    }
    .volet.ouvert {
      height: 460px;
    }
    .volet:not(.ouvert) h3 {
      writing-mode: horizontal-tb;
      transform: none;
      font-size: 1.1rem;
    }
    .volet:not(.ouvert) .volet__int {
      top: 0;
      flex-direction: row;
      align-items: center;
      gap: 0.9rem;
    }
    .volet__num {
      font-size: 1.7rem;
    }
    .volet.ouvert h3 {
      white-space: normal;
    }
  }

  /* ============ Ce soir ============ */
  .couche--observer {
    isolation: isolate;
    overflow: hidden;
  }
  .observer__photo {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
    opacity: 0.45;
  }
  .observer__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      var(--aubergine-900),
      rgba(26, 15, 27, 0.35) 30%,
      rgba(26, 15, 27, 0.35) 70%,
      var(--aubergine-900)
    );
  }
  .observer__grille {
    display: grid;
    gap: 2rem;
    align-items: center;
    margin-top: 2.5rem;
  }
  @media (min-width: 900px) {
    .observer__grille {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3.5rem;
    }
  }
  .lune,
  .ciel-case,
  .conseil {
    border: 1px solid var(--creme-12);
    border-radius: var(--rayon);
    background: rgba(18, 10, 18, 0.62);
    backdrop-filter: blur(8px);
  }
  .lune {
    padding: 1.8rem;
    text-align: center;
  }
  .lune__disque {
    display: block;
    width: min(280px, 80%);
    height: auto;
    aspect-ratio: 1;
    margin: auto;
    filter: drop-shadow(0 0 28px rgba(248, 220, 190, 0.18));
  }
  .lune__resume {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: var(--creme-70);
  }
  .ciel-grille {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .ciel-case {
    padding: 1.3rem;
  }
  .ciel-case small {
    display: block;
    margin-bottom: 0.6rem;
    font: 600 10px var(--font-hud);
    letter-spacing: 0.2em;
    color: var(--creme-45);
  }
  .ciel-case b {
    display: block;
    font: 700 1.45rem / 1.15 var(--font-titre);
    color: var(--creme);
  }
  .ciel-case span {
    font-size: 0.85rem;
    color: var(--creme-70);
  }
  .conseils {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    margin-top: 3rem;
  }
  .conseil {
    padding: 1.5rem;
    transition: border-color 0.4s, transform 0.4s;
  }
  .conseil:hover {
    border-color: var(--ci-orange);
    transform: translateY(-5px);
  }
  .conseil i {
    display: block;
    margin-bottom: 0.5rem;
    font: 700 1.9rem var(--font-titre);
    font-style: normal;
    color: var(--ci-orange);
  }
  .conseil h3 {
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }
  .conseil p {
    font-size: 0.9rem;
    color: var(--creme-70);
    margin: 0;
  }
  .credits {
    margin-top: 1.4rem;
    font-size: 0.75rem;
    color: var(--creme-45);
  }
  @media (max-width: 420px) {
    .ciel-grille {
      grid-template-columns: 1fr;
    }
  }

  /* ============ Couche 6 : Abidjan ============ */
  .couche--abidjan {
    text-align: center;
    padding-bottom: calc(var(--espace-section) * 0.6);
  }
  .couche--abidjan::before {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 75%;
    background:
      radial-gradient(58% 46% at 50% 100%, rgba(247, 127, 0, 0.16), transparent 70%),
      linear-gradient(to top, rgba(0, 158, 96, 0.05), transparent 45%);
    pointer-events: none;
  }
  .abidjan__int {
    position: relative;
  }
  .abidjan__titre {
    font-size: clamp(1.9rem, 5vw, 3.3rem);
    max-width: 22ch;
    margin-inline: auto;
  }
  .abidjan__p {
    margin-inline: auto;
  }
  .abidjan__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 1.8rem;
  }
  .abidjan__partenaires-titre {
    margin-top: 4rem;
    font-family: var(--font-hud);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
