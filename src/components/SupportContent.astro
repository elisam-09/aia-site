---
import PageIntro from './PageIntro.astro';
import { getProducts } from '../lib/content';
import { routes, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const produits = await getProducts(lang);

const C = {
  fr: {
    eyebrow: 'Support',
    titre: 'Soutenir l’AIA, c’est financer des étoiles',
    lead: "Nos produits dérivés financent les tournées scolaires, l'entretien des télescopes et les campagnes de recherche. Vitrine uniquement : pour commander, contacte-nous — remise en main propre à Abidjan.",
    dispo: 'Disponible',
    rupture: 'Bientôt de retour',
    commander: 'Commander via la page Contact',
    donsTitre: 'Dons & mécénat',
    donsP1: "Institutions, entreprises, diaspora : un don ou un partenariat matériel (optique, informatique, transport) a un impact direct et visible — chaque télescope financé, ce sont des centaines de premiers regards vers le ciel.",
    donsP2: 'Nous privilégions la transparence : chaque soutien est documenté et remercié publiquement (sauf demande contraire).',
    donsCta: 'Discuter d’un soutien',
  },
  en: {
    eyebrow: 'Support',
    titre: 'Supporting AIA means funding stars',
    lead: 'Our merchandise funds school tours, telescope maintenance and research campaigns. Showcase only: to order, contact us — hand delivery in Abidjan.',
    dispo: 'Available',
    rupture: 'Back soon',
    commander: 'Order via the Contact page',
    donsTitre: 'Donations & sponsorship',
    donsP1: 'Institutions, companies, diaspora: a donation or in-kind partnership (optics, computing, transport) has a direct, visible impact — every funded telescope means hundreds of first looks at the sky.',
    donsP2: 'We value transparency: every contribution is documented and publicly acknowledged (unless requested otherwise).',
    donsCta: 'Discuss a contribution',
  },
}[lang];
---

<PageIntro eyebrow={C.eyebrow} titre={C.titre} lead={C.lead} />

<section class="container">
  <div class="grid-2 produits">
    {
      produits.map((pr) => (
        <article class="produit">
          <div class="produit__visuel">
            <img src={pr.image} alt={pr.nom} loading="lazy" />
            <span class:list={['produit__badge', { off: !pr.dispo }]}>
              {pr.dispo ? C.dispo : C.rupture}
            </span>
          </div>
          <div class="produit__corps">
            <h3>{pr.nom}</h3>
            <p>{pr.description}</p>
            <p class="produit__prix">{pr.prix}</p>
          </div>
        </article>
      ))
    }
  </div>
  <p class="produits__note">
    <a class="btn btn-contour" href={routes.contact[lang]}>{C.commander} →</a>
  </p>
</section>

<section class="container dons">
  <h2 class="section-title">{C.donsTitre}</h2>
  <p>{C.donsP1}</p>
  <p>{C.donsP2}</p>
  <a class="btn btn-vert" href={routes.contact[lang]}>{C.donsCta}</a>
</section>

<style>
  .produit {
    border: 1px solid var(--creme-12);
    border-radius: var(--rayon);
    overflow: hidden;
    background: rgba(248, 247, 248, 0.03);
    display: flex;
    flex-direction: column;
  }

  .produit__visuel {
    position: relative;
  }

  .produit__badge {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    font-family: var(--font-hud);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--aubergine-950);
    background: var(--ci-vert-clair);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
  }

  .produit__badge.off {
    background: var(--creme-3);
  }

  .produit__corps {
    padding: 1.2rem 1.3rem 1.4rem;
  }

  .produit__corps h3 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }

  .produit__corps p {
    color: var(--creme-70);
    font-size: 0.93rem;
  }

  .produit__prix {
    font-family: var(--font-hud);
    color: var(--ci-orange-vif) !important;
    letter-spacing: 0.08em;
    margin: 0;
  }

  .produits__note {
    margin-top: 1.8rem;
  }

  .dons {
    margin-top: clamp(3rem, 8vh, 5rem);
    border: 1px solid rgba(0, 158, 96, 0.35);
    border-radius: calc(var(--rayon) * 1.4);
    padding: clamp(1.6rem, 4vw, 2.6rem);
    background:
      radial-gradient(70% 130% at 0% 0%, rgba(0, 158, 96, 0.08), transparent 60%),
      rgba(18, 10, 18, 0.5);
  }

  .dons p {
    max-width: 52rem;
    color: var(--creme-2);
  }

  .dons .btn {
    margin-top: 0.4rem;
  }
</style>
