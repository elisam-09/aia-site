---
import PageIntro from './PageIntro.astro';
import { routes, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const C = {
  fr: {
    eyebrow: 'Nous soutenir',
    titre: 'Soutenir l’AIA, c’est financer des étoiles',
    lead: "L'AIA manque de financement public : chaque soutien sert directement le matériel d'observation, les tournées scolaires et le projet d'observatoire national.",
    facons: [
      {
        t: 'Devenir membre',
        p: 'Les cotisations des membres financent les premiers équipements : télescopes, matériel d’observation.',
        cta: 'Rejoindre l’AIA',
        href: routes.join.fr,
      },
      {
        t: 'Faire un don',
        p: 'Un don, même modeste, aide à faire tourner les observations publiques gratuites et les clubs dans les lycées.',
        cta: 'Nous écrire',
        href: routes.contact.fr,
      },
      {
        t: 'Mécénat & partenariat',
        p: 'Institutions, entreprises, diaspora : un partenariat matériel (optique, informatique, transport) a un impact direct et visible.',
        cta: 'Discuter d’un soutien',
        href: routes.contact.fr,
      },
    ],
    transparence:
      'Nous privilégions la transparence : chaque soutien est documenté et remercié publiquement (sauf demande contraire).',
  },
  en: {
    eyebrow: 'Support us',
    titre: 'Supporting AIA means funding stars',
    lead: 'AIA lacks public funding: every contribution goes directly to observing equipment, school tours and the national observatory project.',
    facons: [
      {
        t: 'Become a member',
        p: 'Membership fees fund the first equipment: telescopes and observing gear.',
        cta: 'Join AIA',
        href: routes.join.en,
      },
      {
        t: 'Make a donation',
        p: 'Even a small donation helps keep free public stargazing and high-school clubs running.',
        cta: 'Write to us',
        href: routes.contact.en,
      },
      {
        t: 'Sponsorship & partnership',
        p: 'Institutions, companies, diaspora: an in-kind partnership (optics, computing, transport) has a direct, visible impact.',
        cta: 'Discuss a contribution',
        href: routes.contact.en,
      },
    ],
    transparence:
      'We value transparency: every contribution is documented and publicly acknowledged (unless requested otherwise).',
  },
}[lang];
---

<PageIntro eyebrow={C.eyebrow} titre={C.titre} lead={C.lead} />

<section class="container">
  <div class="facons">
    {
      C.facons.map((f, i) => (
        <article class="facon">
          <span class="facon__num">0{i + 1}</span>
          <h2>{f.t}</h2>
          <p>{f.p}</p>
          <a class:list={['btn', i === 0 ? 'btn-primaire' : 'btn-contour']} href={f.href}>
            {f.cta} →
          </a>
        </article>
      ))
    }
  </div>
  <p class="transparence">{C.transparence}</p>
</section>

<style>
  .facons {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
  }

  .facon {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 1.8rem 1.6rem;
    border: 1px solid var(--creme-12);
    border-radius: var(--rayon);
    background: rgba(18, 10, 18, 0.5);
    transition: border-color var(--transition), transform var(--transition);
  }

  .facon:hover {
    border-color: var(--ci-vert);
    transform: translateY(-4px);
  }

  .facon__num {
    font: 700 2.4rem / 1 var(--font-titre);
    color: transparent;
    -webkit-text-stroke: 1px var(--ci-vert);
  }

  .facon h2 {
    font-size: var(--taille-h3);
    margin: 0.4rem 0 0;
  }

  .facon p {
    color: var(--creme-70);
    flex: 1;
  }

  .transparence {
    margin-top: 2rem;
    color: var(--creme-45);
    font-size: 0.9rem;
  }
</style>
